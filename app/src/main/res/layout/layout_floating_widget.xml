<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/innerLayout"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#CC181818"
        android:padding="6dp">

        <LinearLayout
            android:id="@+id/dragHeader"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#DD2B2B2B"
            android:paddingHorizontal="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="우마 카운터 (드래그)"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnToggleResize"
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:text="크기"
                android:textColor="#FFEB3B"
                android:textSize="11sp"
                android:gravity="center"
                android:background="#333333"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/btnMinimize"
                android:layout_width="24dp"
                android:layout_height="wrap_content"
                android:text="-"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:gravity="center" />

            <TextView
                android:id="@+id/btnClose"
                android:layout_width="24dp"
                android:layout_height="wrap_content"
                android:text="×"
                android:textColor="#FF5252"
                android:textSize="16sp"
                android:gravity="center" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginTop="6dp">

            <GridLayout
                android:id="@+id/cardGrid"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:columnCount="3"
                android:rowCount="2">

                <Button android:id="@+id/btnCard1" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="0dp" android:layout_rowWeight="1" android:textSize="10sp" android:layout_margin="2dp" android:padding="2dp" />
                <Button android:id="@+id/btnCard2" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="0dp" android:layout_rowWeight="1" android:textSize="10sp" android:layout_margin="2dp" android:padding="2dp" />
                <Button android:id="@+id/btnCard3" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="0dp" android:layout_rowWeight="1" android:textSize="10sp" android:layout_margin="2dp" android:padding="2dp" />

                <Button android:id="@+id/btnCard4" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="0dp" android:layout_rowWeight="1" android:textSize="10sp" android:layout_margin="2dp" android:padding="2dp" />
                <Button android:id="@+id/btnCard5" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="0dp" android:layout_rowWeight="1" android:textSize="10sp" android:layout_margin="2dp" android:padding="2dp" />
                <Button android:id="@+id/btnCard6" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="0dp" android:layout_rowWeight="1" android:textSize="10sp" android:layout_margin="2dp" android:padding="2dp" />
            </GridLayout>

            <Button
                android:id="@+id/btnReset"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:text="초기화"
                android:textSize="11sp"
                android:backgroundTint="#444444"
                android:textColor="#FFFFFF"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/resizeHandle"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="bottom|end"
        android:text="⇲"
        android:textColor="#FFEB3B"
        android:textSize="18sp"
        android:gravity="center"
        android:background="#AA000000"
        android:visibility="gone" />
</FrameLayout>
