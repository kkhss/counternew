<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#CC181818"
    android:padding="6dp">

    <!-- 헤더 영역 -->
    <LinearLayout
        android:id="@+id/dragHeader"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#DD2B2B2B"
        android:paddingHorizontal="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="우마 카운터 (드래그)"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- 직관적인 크기 축소/확대 버튼 -->
        <TextView
            android:id="@+id/btnScaleDown"
            android:layout_width="26dp"
            android:layout_height="wrap_content"
            android:text="축소"
            android:textColor="#FFEB3B"
            android:textSize="10sp"
            android:gravity="center"
            android:background="#333333"
            android:layout_marginEnd="3dp" />

        <TextView
            android:id="@+id/btnScaleUp"
            android:layout_width="26dp"
            android:layout_height="wrap_content"
            android:text="확대"
            android:textColor="#FFEB3B"
            android:textSize="10sp"
            android:gravity="center"
            android:background="#333333"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/btnMinimize"
            android:layout_width="22dp"
            android:layout_height="wrap_content"
            android:text="-"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:gravity="center" />

        <TextView
            android:id="@+id/btnClose"
            android:layout_width="22dp"
            android:layout_height="wrap_content"
            android:text="×"
            android:textColor="#FF5252"
            android:textSize="16sp"
            android:gravity="center" />
    </LinearLayout>

    <!-- 카드 영역 (정상 출력되도록 고정 높이 적용) -->
    <LinearLayout
        android:id="@+id/cardContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="6dp">

        <LinearLayout
            android:id="@+id/row1"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal">
            <Button android:id="@+id/btnCard1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="9.5sp" android:layout_margin="2dp" android:padding="1dp" />
            <Button android:id="@+id/btnCard2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="9.5sp" android:layout_margin="2dp" android:padding="1dp" />
            <Button android:id="@+id/btnCard3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="9.5sp" android:layout_margin="2dp" android:padding="1dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row2"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:layout_marginTop="2dp">
            <Button android:id="@+id/btnCard4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="9.5sp" android:layout_margin="2dp" android:padding="1dp" />
            <Button android:id="@+id/btnCard5" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="9.5sp" android:layout_margin="2dp" android:padding="1dp" />
            <Button android:id="@+id/btnCard6" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:textSize="9.5sp" android:layout_margin="2dp" android:padding="1dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnReset"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:text="초기화"
            android:textSize="11sp"
            android:backgroundTint="#444444"
            android:textColor="#FFFFFF"
            android:layout_marginTop="4dp" />
    </LinearLayout>
</LinearLayout>
